# Copy this file to .env and fill in the values. Never commit .env to git.

# Port the server listens on
PORT=3000

# Admin account for the admin panel. Created on first start if it does not exist.
# ADMIN_PASSWORD must be at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# HubSpot Private App access token (Settings > Integrations > Private Apps)
# Required scopes: crm.objects.contacts.write, crm.objects.contacts.read
HUBSPOT_TOKEN=

# Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq API key (https://console.groq.com/keys). Used first for AI design suggestions. Free tier, no card.
GROQ_API_KEY=
GROQ_MODEL=GROQ_MODEL=openai/gpt-oss-120b

# Gemini model string (backup provider). Check the current free-tier model names in Google AI Studio
# and update this if the default is retired.
GEMINI_MODEL=gemini-3.8-flash

# Database file (default: server/data/cresthaven.db). Put it on a persistent disk in production.
# DB_PATH=/var/data/cresthaven.db

# Set to 1 when the site runs on HTTPS, so the login cookie is sent only over HTTPS.
COOKIE_SECURE=0
